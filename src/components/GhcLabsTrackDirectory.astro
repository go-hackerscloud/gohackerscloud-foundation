---
import {ghcLabTracks,ghcTrackURL} from '../data/ghc-labs-tracks.mjs';
const groups=[
{type:'hands-on',title:'Practical technical tracks',note:'Guided technical content with hosted practice where provided.'},
{type:'learning',title:'Learning and career resources',note:'Knowledge and methods that support laboratory practice.'},
{type:'challenge',title:'Projects and challenges',note:'Activities that bring several skills together.'},
];
---
<div class="ghc-labs-track-directory">
  {groups.map(group=>(<section class="ghc-labs-group">
    <header><h2>{group.title}</h2><p>{group.note}</p></header>
    <div class="ghc-labs-track-grid">
      {ghcLabTracks.filter(track=>track.type===group.type).map(track=>(
        <a href={ghcTrackURL(track.id)} class="ghc-labs-track-card" aria-label={`Explore Academy track ${track.name}`}>
          <span>{group.type.toUpperCase()}</span>
          <strong>{track.name}</strong>
          <p>{track.description}</p>
          <b>View Academy track <span aria-hidden="true">↗</span></b>
        </a>
      ))}
    </div>
  </section>))}
</div>
<style>
.ghc-labs-track-directory{margin:1.35rem 0 2rem}
.ghc-labs-group{margin-bottom:1.7rem}
.ghc-labs-group h2{font-size:1.45rem;margin:0 0 .45rem!important}
.ghc-labs-group header p{margin:0 0 1.15rem;font-size:.88rem;color:var(--sl-color-gray-2)}
.ghc-labs-track-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem;align-items:stretch}
.ghc-labs-track-card{display:flex;flex-direction:column;gap:.6rem;min-width:0;padding:1.1rem;border:1px solid var(--sl-color-gray-5);border-radius:14px;background:var(--sl-color-bg-nav);color:var(--sl-color-text)!important;text-decoration:none!important;transition:border-color .16s ease,transform .16s ease}
.ghc-labs-track-card:hover{border-color:var(--sl-color-accent);transform:translateY(-2px)}
.ghc-labs-track-card:focus-visible{outline:3px solid var(--sl-color-accent);outline-offset:3px}
.ghc-labs-track-card span:first-child{font-size:.67rem;font-weight:850;letter-spacing:.07em;color:var(--sl-color-accent-high)}
.ghc-labs-track-card strong{font-size:1.03rem;line-height:1.35}
.ghc-labs-track-card p{margin:0 0 .3rem;font-size:.83rem;line-height:1.6;color:var(--sl-color-gray-2);flex:1}
.ghc-labs-track-card b{font-size:.78rem;color:var(--sl-color-accent-high)}
@media(max-width:970px){.ghc-labs-track-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.ghc-labs-track-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.ghc-labs-track-card{transition:none}}
</style>
