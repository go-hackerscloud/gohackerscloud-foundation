---
import {getCollection} from 'astro:content';
import {foundationModules, foundationGroups} from '../data/foundation-modules.mjs';

const allDocs = await getCollection('docs');
const modules = foundationModules.map(module => {
  const prefix = module.link.split('/').filter(Boolean).slice(0, 3).join('/') + '/';
  const lessons = allDocs
    .filter(entry => entry.id.startsWith(prefix))
    .sort((left, right) => left.id.localeCompare(right.id, undefined, {numeric: true}));
  return {...module, lessons};
});
---
<section class="foundation-directory" id="lesson-directory" aria-labelledby="foundation-directory-heading" data-foundation-lesson-directory>
  <div class="foundation-directory-heading">
    <span class="foundation-directory-kicker">LESSON-BY-LESSON NAVIGATION</span>
    <h2 id="foundation-directory-heading">Browse the full Foundation syllabus</h2>
    <p>Open any module to see its published lessons, assessments and practical materials. These links are built from the actual content collection, so new lessons added through Obsidian appear here after the next successful publish.</p>
  </div>
  {foundationGroups.map(group => (
    <div class="foundation-directory-stage">
      <h3>{group.title}</h3>
      <div class="foundation-directory-list">
        {modules.filter(module => module.category === group.id).map(module => (
          <details class="foundation-directory-module" id={`module-${module.id}`} data-foundation-directory-module>
            <summary>
              <span class="foundation-directory-id">MODULE {module.id}</span>
              <span class="foundation-directory-name">{module.title}</span>
              <span class="foundation-directory-total">{module.lessons.length} resources</span>
              <span class="foundation-directory-arrow" aria-hidden="true">⌄</span>
            </summary>
            <div class="foundation-directory-body">
              <p><strong>Learning outcome:</strong> {module.outcome}</p>
              <ol>
                {module.lessons.map(lesson => (
                  <li class="foundation-directory-lesson">
                    <a class="foundation-directory-link" href={`/${lesson.id}/`}>{lesson.data.title}</a>
                  </li>
                ))}
              </ol>
              <a class="foundation-directory-begin" href={module.link}>Start from the first lesson <span aria-hidden="true">→</span></a>
            </div>
          </details>
        ))}
      </div>
    </div>
  ))}
</section>
<style>
.foundation-directory{margin:3.1rem 0 2.8rem;scroll-margin-top:1rem}
.foundation-directory-heading{max-width:74ch;margin-bottom:1.7rem}
.foundation-directory-kicker{color:var(--sl-color-accent-high);font-size:.72rem;font-weight:800;letter-spacing:.08em}
.foundation-directory-heading h2{font-size:clamp(1.45rem,2.5vw,2rem);letter-spacing:-.035em;margin:.5rem 0!important}
.foundation-directory-heading p{font-size:.9rem;line-height:1.7;color:var(--sl-color-gray-2);margin:0}
.foundation-directory-stage{margin-top:2rem}
.foundation-directory-stage h3{font-size:1.04rem;margin-bottom:.85rem}
.foundation-directory-list{display:grid;gap:.6rem}
.foundation-directory-module{border:1px solid var(--sl-color-gray-5);border-radius:12px;background:var(--sl-color-bg-nav);overflow:hidden;scroll-margin-top:1rem}
.foundation-directory-module summary{display:grid;grid-template-columns:80px minmax(0,1fr) auto 18px;gap:.8rem;align-items:center;list-style:none;cursor:pointer;padding:1.05rem 1.2rem;color:var(--sl-color-text)}
.foundation-directory-module summary::-webkit-details-marker{display:none}
.foundation-directory-module summary:focus-visible{outline:3px solid var(--sl-color-accent);outline-offset:-3px}
.foundation-directory-id{font-size:.67rem;letter-spacing:.04em;font-weight:800;color:var(--sl-color-accent-high)}
.foundation-directory-name{font-size:.92rem;line-height:1.35;font-weight:750}
.foundation-directory-total{font-size:.75rem;color:var(--sl-color-gray-2);white-space:nowrap}
.foundation-directory-arrow{font-size:1.1rem;text-align:center;transition:transform .15s ease}
.foundation-directory-module[open] .foundation-directory-arrow{transform:rotate(180deg)}
.foundation-directory-module[open]{border-color:var(--sl-color-accent)}
.foundation-directory-body{padding:0 1.2rem 1.2rem;border-top:1px solid var(--sl-color-gray-5)}
.foundation-directory-body p{margin:.95rem 0;font-size:.81rem;line-height:1.6;color:var(--sl-color-gray-2)}
.foundation-directory-body ol{list-style:decimal;padding:0 0 0 1.7rem;margin:.7rem 0 1rem;columns:2;column-gap:2rem}
.foundation-directory-lesson{break-inside:avoid;margin:.38rem 0;padding-left:.2rem;font-size:.81rem;line-height:1.5}
.foundation-directory-link{color:var(--sl-color-text);text-decoration:none}
.foundation-directory-link:hover{text-decoration:underline;color:var(--sl-color-accent-high)}
.foundation-directory-begin{font-size:.84rem;font-weight:800;text-decoration:none}
@media(max-width:650px){.foundation-directory-module summary{grid-template-columns:1fr 19px;gap:.32rem .5rem;padding:.9rem}.foundation-directory-id{grid-column:1}.foundation-directory-name{grid-column:1}.foundation-directory-total{grid-column:1}.foundation-directory-arrow{grid-column:2;grid-row:1 / 4}.foundation-directory-body ol{columns:1}}
@media(prefers-reduced-motion:reduce){.foundation-directory-arrow{transition:none}}
</style>
