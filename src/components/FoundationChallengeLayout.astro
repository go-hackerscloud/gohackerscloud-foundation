---
import { foundationChallengeDays } from '../data/foundation-challenge.mjs';
---
<div class="ghc-challenge-layout">
  <div class="ghc-challenge-content">
    <slot />
  </div>
  <aside class="ghc-challenge-rail" aria-label="Seven-day challenge study companion">
    <div class="ghc-challenge-rail-card">
      <span class="ghc-rail-eyebrow">YOUR LEARNING COMPANION</span>
      <h2 class="ghc-rail-title">Your 7-day roadmap</h2>
      <p class="ghc-rail-description">Pick a day, open its free lesson and complete the three-question check at your own pace.</p>
      <div class="ghc-rail-progress-heading">
        <strong>Self-reviewed days</strong>
        <span data-challenge-rail-count aria-live="off">0 / 7</span>
      </div>
      <progress data-challenge-rail-bar value="0" max="7" aria-label="Self-reviewed days out of seven">0 of 7</progress>
      <nav class="ghc-rail-day-nav" aria-label="Jump to a challenge day">
        {foundationChallengeDays.map(day => (
          <a class="ghc-rail-day-link" href={'#challenge-day-'+day.id} data-challenge-day-link={day.id} data-reviewed="false">
            <span class="ghc-rail-day-number">{day.id}</span>
            <span class="ghc-rail-day-text">{day.title}</span>
            <span class="ghc-rail-day-check" aria-hidden="true">✓</span>
          </a>
        ))}
      </nav>
      <p class="ghc-rail-status-note">Progress is self-reported; browser saving is optional and controlled in the challenge below.</p>
    </div>
    <div class="ghc-challenge-rail-resources">
      <p class="ghc-rail-resources-eyebrow">FREE NEXT STEPS</p>
      <h2 class="ghc-rail-resources-title">Continue building skills</h2>
      <nav aria-label="Related Foundation learning resources">
        <a href="/portfolio/">Career & Portfolio Hub <span aria-hidden="true">↗</span></a>
        <a href="/curriculum/">Explore all 16 modules <span aria-hidden="true">↗</span></a>
        <a href="/paths/students/">Student learning path <span aria-hidden="true">↗</span></a>
        <a href="/paths/professionals/">Professional upskilling <span aria-hidden="true">↗</span></a>
      </nav>
      <p class="ghc-rail-footnote">All linked Foundation lessons and portfolio templates are free. Hosted Academy labs are a separate, optional offering.</p>
    </div>
  </aside>
</div>
<style>
.ghc-challenge-layout{
  width:100%;
  max-width:84rem;
  margin-inline:auto;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(15rem,18rem);
  gap:clamp(1.3rem,3vw,2.8rem);
  align-items:start;
}
.ghc-challenge-content{min-width:0}
.ghc-challenge-content :global(h2){scroll-margin-top:6rem}
.ghc-challenge-content :global(.ghc-challenge){margin-bottom:2rem}
.ghc-challenge-rail{
  position:sticky;
  top:5.6rem;
  align-self:start;
  min-width:0;
  max-height:calc(100vh - 6.5rem);
  max-height:calc(100dvh - 6.5rem);
  overflow-y:auto;
  overscroll-behavior:contain;
  scrollbar-width:thin;
  display:grid;
  gap:1rem;
}
.ghc-challenge-rail-card{
  background:var(--sl-color-bg-nav);
  border:1px solid var(--sl-color-gray-5);
  border-radius:16px;
  padding:1.15rem;
  min-width:0;
}
.ghc-rail-eyebrow,.ghc-rail-resources-eyebrow{
  display:block;
  color:var(--sl-color-accent-high);
  font-size:.66rem;
  letter-spacing:.095em;
  font-weight:850;
}
.ghc-rail-title{
  margin:.45rem 0 .45rem!important;
  font-size:1.14rem!important;
  line-height:1.25!important;
  letter-spacing:-.02em;
  padding:0!important;
  border:0!important;
}
.ghc-rail-description{margin:0 0 1.05rem!important;font-size:.78rem;line-height:1.65;color:var(--sl-color-gray-2)}
.ghc-rail-progress-heading{display:flex;justify-content:space-between;gap:.5rem;align-items:center}
.ghc-rail-progress-heading strong{font-size:.76rem}
.ghc-rail-progress-heading span{color:var(--sl-color-accent-high);font-weight:800;font-size:.74rem;white-space:nowrap}
.ghc-challenge-rail progress{display:block;width:100%;height:9px;accent-color:var(--sl-color-accent);margin:.45rem 0 1rem}
.ghc-rail-day-nav{display:grid;gap:.26rem}
.ghc-rail-day-link{
  display:grid;
  grid-template-columns:1.55rem minmax(0,1fr) .9rem;
  gap:.45rem;
  align-items:center;
  min-width:0;
  border:1px solid transparent;
  border-radius:9px;
  padding:.48rem .42rem;
  background:transparent;
  color:var(--sl-color-text)!important;
  text-decoration:none!important;
  font-size:.78rem;
  line-height:1.35;
}
.ghc-rail-day-link:hover{background:var(--sl-color-bg);border-color:var(--sl-color-gray-5)}
.ghc-rail-day-number{font-size:.73rem;font-weight:850;color:var(--sl-color-accent-high)}
.ghc-rail-day-text{min-width:0;overflow-wrap:anywhere}
.ghc-rail-day-check{visibility:hidden;color:var(--sl-color-accent-high);font-weight:850;font-size:.86rem}
.ghc-rail-day-link[data-reviewed="true"]{background:var(--sl-color-bg);border-color:var(--sl-color-gray-5)}
.ghc-rail-day-link[data-reviewed="true"] .ghc-rail-day-check{visibility:visible}
.ghc-rail-status-note{margin:.95rem 0 0!important;color:var(--sl-color-gray-2);font-size:.69rem;line-height:1.5}
.ghc-challenge-rail-resources{padding:1rem 1.1rem;background:var(--sl-color-bg);border:1px solid var(--sl-color-gray-5);border-radius:14px}
.ghc-rail-resources-title{font-size:.94rem!important;line-height:1.3!important;margin:.35rem 0 .75rem!important;padding:0!important;border:0!important}
.ghc-challenge-rail-resources nav{display:grid;gap:.05rem}
.ghc-challenge-rail-resources a{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:.7rem;
  min-height:37px;
  padding:.35rem .1rem;
  color:var(--sl-color-text);
  font-size:.77rem;
  text-decoration:none;
  border-bottom:1px solid var(--sl-color-gray-5);
}
.ghc-challenge-rail-resources a:hover{color:var(--sl-color-accent-high)}
.ghc-challenge-rail-resources nav a:last-child{border-bottom:0}
.ghc-challenge-rail-resources a span{color:var(--sl-color-accent-high)}
.ghc-rail-footnote{font-size:.7rem;line-height:1.55;color:var(--sl-color-gray-2);margin:.7rem 0 0!important}
.ghc-rail-day-link:focus-visible,.ghc-challenge-rail-resources a:focus-visible{
  outline:3px solid var(--sl-color-accent);
  outline-offset:3px;
}
@media(max-width:62rem){
  .ghc-challenge-layout{grid-template-columns:minmax(0,1fr);gap:1.35rem}
  .ghc-challenge-rail{
    grid-row:1;
    position:static;
    max-height:none;
    overflow:visible;
    gap:.65rem;
  }
  .ghc-challenge-rail-card{padding:1rem}
  .ghc-rail-description,.ghc-rail-status-note{display:none}
  .ghc-rail-day-nav{display:flex;overflow-x:auto;gap:.35rem;scroll-snap-type:x proximity;padding-bottom:.5rem}
  .ghc-rail-day-link{flex:0 0 10.7rem;scroll-snap-align:start;min-height:48px;background:var(--sl-color-bg);border-color:var(--sl-color-gray-5)}
  .ghc-challenge-rail-resources{padding:.75rem 1rem}
  .ghc-challenge-rail-resources nav{display:flex;flex-wrap:wrap;gap:.3rem 1rem}
  .ghc-challenge-rail-resources a{min-height:38px;border:0}
  .ghc-rail-resources-title{margin-bottom:.35rem!important}
  .ghc-rail-footnote{display:none}
}
@media(max-width:36rem){
  .ghc-challenge-rail-resources nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem}
  .ghc-challenge-rail-resources a{font-size:.72rem}
}
@media(prefers-reduced-motion:reduce){
  .ghc-rail-day-link{scroll-behavior:auto}
}
</style>
