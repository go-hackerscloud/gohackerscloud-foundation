---
const journeys = [
  {
    index: '01',
    audience: 'STUDENTS & BEGINNERS',
    heading: 'Build your technical foundations',
    description: 'Start from computers and networking, then explore Linux, cloud and cybersecurity through free guided lessons.',
    checkpoints: ['Start with Module 00', 'Learn with short, safe exercises', 'Save your first technical notes'],
    href: '/paths/students/',
    action: 'Explore student path',
  },
  {
    index: '02',
    audience: 'WORKING PROFESSIONALS',
    heading: 'Build on the skills you already have',
    description: 'Choose a relevant security, cloud, DevOps or enterprise topic. Review core concepts and create a useful workplace-style deliverable.',
    checkpoints: ['Identify your current skill gap', 'Follow targeted Foundation modules', 'Create a portfolio-ready sample report'],
    href: '/paths/professionals/',
    action: 'Explore professional path',
  },
];
---
<section class="foundation-paths" id="choose-your-path" aria-labelledby="foundation-paths-heading">
  <div class="foundation-paths-intro">
    <span class="foundation-paths-eyebrow">YOUR FREE LEARNING STARTS HERE</span>
    <h2 id="foundation-paths-heading">Choose a path that fits your experience</h2>
    <p>Whether you're studying for your first technical role or strengthening skills for your next project, Foundation gives you a structured starting point—without a paid subscription.</p>
  </div>
  <div class="foundation-paths-grid">
    {journeys.map(journey => (
      <article class="foundation-path-card">
        <span class="foundation-path-type">{journey.index} · {journey.audience}</span>
        <h3>{journey.heading}</h3>
        <p>{journey.description}</p>
        <ul>
          {journey.checkpoints.map(checkpoint => <li>{checkpoint}</li>)}
        </ul>
        <a href={journey.href} class="foundation-path-link">
          {journey.action} <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>
  <p class="foundation-path-note">Not sure yet? <a href="/curriculum/">Browse all 16 free modules</a> and choose a subject you enjoy. No career decision or purchase is required.</p>
</section>
<style>
.foundation-paths{margin:2.15rem 0 2.6rem;scroll-margin-top:1.25rem}
.foundation-paths-intro{max-width:76ch}
.foundation-paths-eyebrow{font-size:.7rem;font-weight:800;letter-spacing:.105em;color:var(--sl-color-accent-high)}
.foundation-paths-intro h2{font-size:clamp(1.5rem,2.7vw,2.2rem);line-height:1.2;letter-spacing:-.035em;margin:.4rem 0 .65rem!important}
.foundation-paths-intro p{font-size:.92rem;line-height:1.7;color:var(--sl-color-gray-2);margin:0 0 1.4rem}
.foundation-paths-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.foundation-path-card{display:flex;flex-direction:column;align-items:flex-start;gap:.8rem;padding:1.4rem;border:1px solid var(--sl-color-gray-5);border-radius:16px;background:var(--sl-color-bg-nav);min-width:0}
.foundation-path-card:first-child{border-color:var(--sl-color-accent)}
.foundation-path-type{color:var(--sl-color-accent-high);font-size:.69rem;letter-spacing:.08em;font-weight:850}
.foundation-path-card h3{font-size:1.18rem;line-height:1.3;letter-spacing:-.015em;margin:0!important}
.foundation-path-card p{font-size:.88rem;line-height:1.65;color:var(--sl-color-gray-2);margin:0}
.foundation-path-card ul{padding:0;margin:.1rem 0 0;list-style:none;display:grid;gap:.5rem}
.foundation-path-card li{font-size:.83rem;line-height:1.45;color:var(--sl-color-text)}
.foundation-path-card li::before{content:'✓';color:var(--sl-color-accent-high);font-weight:800;margin-right:.5rem}
.foundation-path-link{margin-top:auto;display:inline-flex;align-items:center;gap:.6rem;padding:.55rem 0;min-height:44px;font-size:.88rem;font-weight:800;text-decoration:underline;text-underline-offset:4px}
.foundation-path-link:focus-visible,.foundation-path-note a:focus-visible{outline:3px solid var(--sl-color-accent);outline-offset:3px}
.foundation-path-note{font-size:.82rem;color:var(--sl-color-gray-2);margin:1rem 0 0;line-height:1.65}
@media(max-width:720px){.foundation-paths-grid{grid-template-columns:1fr}.foundation-path-card{padding:1.15rem}}
</style>
